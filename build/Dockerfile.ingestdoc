FROM python:3.12-slim

WORKDIR /code

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgdiplus && \
    apt-get clean

RUN addgroup --system appgroup && adduser --system appuser

COPY /code/dependencies/requirements.txt /code/requirements.txt

RUN pip install --upgrade pip

RUN pip install --no-cache-dir -r requirements.txt

COPY /code/backend/apps/ingest_documents /code/apps/ingest_documents
COPY /code/backend/core /code/core
COPY /code/backend/main.py /code/main.py
COPY /code/backend/logging.conf /code/logging.conf

RUN chown -R appuser:appgroup /code

USER appuser

ENV PYTHONPATH=/code

ENV FAST_API_APP_PATH=apps.ingest_documents.server:app

EXPOSE 8000

CMD ["python", "main.py"]