FROM python:3.12-slim

WORKDIR /code

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    libgdiplus && \
    apt-get clean

RUN addgroup --system appgroup && adduser --system appuser

COPY /code/dependencies/requirements.txt /code/requirements.txt

RUN pip install --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

COPY /code/backend/apps/archival /code/apps/archival
COPY /code/backend/core /code/core
COPY /code/backend/logging.conf /code/logging.conf

RUN chown -R appuser:appgroup /code

USER appuser

ENV PYTHONPATH=/code

CMD ["python", "-u", "/code/apps/archival/handler.py"]